# Copy this file to .env and adjust. Never commit .env.
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
BODY_LIMIT=100kb

# File uploads
STORAGE_DRIVER=local
UPLOADS_DIR=uploads
PUBLIC_BASE_URL=http://localhost:3000
UPLOAD_MAX_BYTES=5242880

# Amazon S3
S3_REGION=us-east-1
S3_BUCKET=
S3_ENDPOINT=
S3_PUBLIC_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=